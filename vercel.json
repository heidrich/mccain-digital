{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "functions": {
    "api/ask.mjs": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mccain-digital.com" }],
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/:path((?!coming-soon/|rechtliches/|robots\\.txt$|.*\\.(?:css|js|mjs|json|woff2|webp|avif|jpe?g|png|svg|ico|gif)$).+)",
      "has": [{ "type": "host", "value": "mccain-digital.com" }],
      "destination": "/coming-soon/",
      "permanent": false
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/kontakt.html",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/brand-guide.html",
      "destination": "/marke/",
      "permanent": true
    },
    {
      "source": "/services/ai-tools.html",
      "destination": "/leistungen/ki-automatisierung/",
      "permanent": true
    },
    {
      "source": "/services/web-apps.html",
      "destination": "/leistungen/web-apps/",
      "permanent": true
    },
    {
      "source": "/services/websites.html",
      "destination": "/leistungen/websites/",
      "permanent": true
    },
    {
      "source": "/services/software.html",
      "destination": "/leistungen/individualsoftware/",
      "permanent": true
    },
    {
      "source": "/legal/imprint.html",
      "destination": "/rechtliches/#impressum",
      "permanent": true
    },
    {
      "source": "/legal/privacy.html",
      "destination": "/rechtliches/#datenschutz",
      "permanent": true
    },
    {
      "source": "/legal/terms.html",
      "destination": "/rechtliches/#agb",
      "permanent": true
    },
    {
      "source": "/legal/withdrawal.html",
      "destination": "/rechtliches/#widerruf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(woff2|webp|jpg|jpeg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(html|xml|txt|json|md)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-fLTa4swNKAK8Mq3ajRtNpy9JknIZid7hIXp5tfgqdzg='; connect-src 'self' https://api.web3forms.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "mccain-digital.com" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
