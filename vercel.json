{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/contact.html", "destination": "/kontakt/", "permanent": true },
    { "source": "/contact", "destination": "/kontakt/", "permanent": true },
    { "source": "/kontakt.html", "destination": "/kontakt/", "permanent": true },
    { "source": "/brand-guide.html", "destination": "/marke/", "permanent": true },

    { "source": "/services/ai-tools.html", "destination": "/leistungen/ki-automatisierung/", "permanent": true },
    { "source": "/services/web-apps.html", "destination": "/leistungen/web-apps/", "permanent": true },
    { "source": "/services/websites.html", "destination": "/leistungen/websites/", "permanent": true },
    { "source": "/services/software.html", "destination": "/leistungen/individualsoftware/", "permanent": true },

    { "source": "/legal/imprint.html", "destination": "/rechtliches/#impressum", "permanent": true },
    { "source": "/legal/privacy.html", "destination": "/rechtliches/#datenschutz", "permanent": true },
    { "source": "/legal/terms.html", "destination": "/rechtliches/#agb", "permanent": true },
    { "source": "/legal/withdrawal.html", "destination": "/rechtliches/#widerruf", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*).(woff2|webp|jpg|jpeg|png|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).(html|xml|txt|json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    }
  ]
}
