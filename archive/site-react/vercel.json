{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/contact.html",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/kontakt.html",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/brand-guide.html",
      "destination": "/marke/",
      "permanent": true
    },
    {
      "source": "/services/ai-tools.html",
      "destination": "/leistungen/ki-automatisierung/",
      "permanent": true
    },
    {
      "source": "/services/web-apps.html",
      "destination": "/leistungen/web-apps/",
      "permanent": true
    },
    {
      "source": "/services/websites.html",
      "destination": "/leistungen/websites/",
      "permanent": true
    },
    {
      "source": "/services/software.html",
      "destination": "/leistungen/individualsoftware/",
      "permanent": true
    },
    {
      "source": "/legal/imprint.html",
      "destination": "/rechtliches/#impressum",
      "permanent": true
    },
    {
      "source": "/legal/privacy.html",
      "destination": "/rechtliches/#datenschutz",
      "permanent": true
    },
    {
      "source": "/legal/terms.html",
      "destination": "/rechtliches/#agb",
      "permanent": true
    },
    {
      "source": "/legal/withdrawal.html",
      "destination": "/rechtliches/#widerruf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(woff2|webp|jpg|jpeg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(html|xml|txt|json|md)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'sha256-8sXCprgMVTJld/+SSaPm+iFxUvW8siEvyi1UQmEUBx0=' 'sha256-PG1Gk7WXQKpAJExN9xiHYqVNAxOw/M0xOeKk13ama44=' 'sha256-lLQtHxcHYrcBFH9XjWhu1QxSP6Yhwqv0gyH57CssD9g='; connect-src 'self' https://api.web3forms.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
