# dependencies / AI tooling
.mind/
.recall/
.mcp.json
*.mp4

# OS
.DS_Store

# internal — kept on disk for development, never part of the public site
labs/
internal/assets-src/
docs/
CHANGELOG.md

# Node dependencies — only the api/ function needs them; the site itself has none.
node_modules/

# generated by `recall init`; whether the repo carries an agent file is an owner call
AGENTS.md

# Parked binaries: the pristine Claude Design export and screen recordings.
# Kept on disk for reference, too large and too regenerable for history.
internal/parked/*.zip

# Python bytecode from the build tools
__pycache__/
*.pyc

# Screenshots are a look, not a record - regenerate with tools/shots.mjs
internal/shots/

# Lighthouse reports: half a megabyte each, regenerable in a minute with the
# skill's `lighthouse-psi.mjs` (~/.claude/skills/html-performance/scripts/).
# The numbers that matter are written down in HANDOFF.md instead.
internal/lighthouse/

# The v4 export's canvas scratch: 119 unreferenced files, 23 MB, and most of it
# is the HALLVERN brand - assets the owner dragged into the Claude Design canvas
# as reference while drawing this site. Nothing in the export links to any of
# it (grep for "uploads/" across mccain-design-system/ finds nothing).
# Kept on disk, out of the history; recoverable from the parked export zip.
mccain-design-system/uploads/

# The build renders each page with react-dom/server in a staging document under
# _dcbuild/ and removes the directory when it is done. It exists only while
# tools/prerender.mjs is running; a crash can leave it behind.
_dcbuild/


# Owner drops DevTools traces here while measuring - never committed.
Trace-*.json
Trace-*.json.gz

internal/lh-assets/

# Secrets live in the Vercel project's environment, never in a file here.
.env
.env.*
